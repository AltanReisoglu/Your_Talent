{
  "name": "00 - Telegram Command Router",
  "nodes": [
    {
      "parameters": {
        "content": "This is the only workflow that owns Telegram Trigger.\nReason: Telegram Bot API supports one webhook per bot, so one router is safer than three Telegram Trigger workflows.\n\nSet these env vars to the production webhook URLs of the child workflows:\n- WF01_SALES_WEBHOOK_URL\n- WF02_PRODUCTION_WEBHOOK_URL\n- WF03_APPROVAL_WEBHOOK_URL\n- DASHBOARD_WEBHOOK_URL\n\nThen connect Telegram credential on Telegram Trigger and Send Message nodes.",
        "width": 560,
        "height": 420,
        "color": 5
      },
      "id": "d7d183af-fd93-461a-a634-2e87794a8148",
      "name": "Read Me - Telegram Router",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -520,
        -360
      ]
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "bab63c29-cf20-4619-906d-f2d28419e560",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "026f0054-a242-4922-991c-ae9539244cb4",
              "name": "command_text",
              "value": "={{ $json.message?.text || \"\" }}",
              "type": "string"
            },
            {
              "id": "19e2c25d-511c-431a-8e2f-035c272f47f8",
              "name": "telegram_chat_id",
              "value": "={{ $json.message?.chat?.id || \"\" }}",
              "type": "string"
            },
            {
              "id": "2f21f643-82b3-4639-a262-fae5cfcd7886",
              "name": "telegram_user_id",
              "value": "={{ $json.message?.from?.id || \"\" }}",
              "type": "string"
            },
            {
              "id": "6e552f87-5862-4687-a5e4-651f5bb6e88d",
              "name": "command_root",
              "value": "={{ String($json.message?.text || \"\").trim().split(/\\s+/)[0] || \"\" }}",
              "type": "string"
            },
            {
              "id": "7ee5cc37-f3f6-4d9a-826c-402f6f61299d",
              "name": "command_subcommand",
              "value": "={{ String($json.message?.text || \"\").trim().split(/\\s+/)[1] || \"\" }}",
              "type": "string"
            },
            {
              "id": "3ccb8611-4f6a-4165-aa36-eae87ee764b0",
              "name": "workflow_target",
              "value": "={{ (() => {\nconst p = String($json.message?.text || '').trim().split(/\\s+/);\nconst root = p[0] || '';\nif (root === '/sales' || root === '/client') return 'wf01_sales';\nif (root === '/content' || root === '/status') return 'wf02_production';\nif (root === '/review' || root === '/deliver' || root === '/invoice') return 'wf03_approval_delivery_invoice';\nif (root === '/summary' || root === '/dashboard') return 'dashboard';\nreturn 'unknown';\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ac8cf1eb-1f1a-4dc7-b345-fd9a7816d83d",
      "name": "Normalize Telegram Command",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "fc10a11e-9960-4769-96ff-b80e5b285d0b",
                    "leftValue": "={{ $json.workflow_target }}",
                    "rightValue": "wf01_sales",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
