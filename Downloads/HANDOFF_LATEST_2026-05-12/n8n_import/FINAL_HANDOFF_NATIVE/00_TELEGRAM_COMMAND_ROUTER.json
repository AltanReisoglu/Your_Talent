                  "version": 2
                },
                "conditions": [
                  {
                    "id": "9ae745e0-fe5c-4dc2-a185-4086e3e37124",
                    "leftValue": "={{ $json.workflow_target }}",
                    "rightValue": "dashboard",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "9e7bfcae-2617-4651-8a23-46706ee98fa3",
      "name": "Switch by Target Workflow",
      "type": "n8n-nodes-base.switch",
