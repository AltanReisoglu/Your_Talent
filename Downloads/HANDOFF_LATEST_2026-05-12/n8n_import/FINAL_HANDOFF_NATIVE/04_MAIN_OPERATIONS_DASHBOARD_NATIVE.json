    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select 'today_overview' as section, json_build_object('new_leads_today', (select count(*) from lead where created_at::date = current_date), 'outreach_sent_today', (select count(*) from lead where last_contact_at::date = current_date), 'new_clients_today', (select count(*) from client where created_at::date = current_date), 'projects_in_production', (select count(*) from project where business_stage = 'In Production'), 'waiting_approval', (select count(*) from approval_item where approval_status = 'waiting_review'), 'deliveries_today', (select count(*) from delivery_record where delivered_at::date = current_date), 'invoices_waiting', (select count(*) from invoice_record where payment_waiting = true)) as data;",
        "options": {}
      },
