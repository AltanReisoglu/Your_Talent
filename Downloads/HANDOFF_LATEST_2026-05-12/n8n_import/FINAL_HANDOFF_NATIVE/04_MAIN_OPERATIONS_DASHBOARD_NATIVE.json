              "id": "60f6106a-1929-4bad-add2-a3d096f93777",
              "name": "command_action",
              "value": "={{ (() => {\nconst p = String($json.body?.command_text || $json.command_text || $json.message?.text || '').trim().split(/\\s+/);\nconst root = p[0] || '';\nconst sub = p[1] || '';\nif (root === '/sales' && sub === 'find') return 'sales_find';\nif (root === '/sales' && sub === 'review') return 'sales_review';\nif (root === '/sales' && sub === 'approve') return 'sales_approve';\nif (root === '/sales' && sub === 'send') return 'sales_send';\nif (root === '/sales' && sub === 'followup') return 'sales_followup';\nif (root === '/client' && sub === 'start') return 'client_start';\nif (root === '/content' && sub === 'create') return 'content_create';\nif (root === '/content' && sub === 'status') return 'content_status';\nif (root === '/content' && sub === 'select') return 'content_select';\nif (root === '/status') return 'content_status';\nif (root === '/review' && sub === 'submit') return 'review_submit';\nif (root === '/review' && sub === 'queue') return 'review_queue';\nif (root === '/review' && sub === 'approve') return 'review_approve';\nif (root === '/review' && sub === 'reject') return 'review_reject';\nif (root === '/review' && sub === 'revise') return 'review_revise';\nif (root === '/deliver') return 'deliver';\nif (root === '/invoice' && sub === 'send') return 'invoice_send';\nif (root === '/summary' && sub === 'today') return 'summary_today';\nif (root === '/dashboard') return 'dashboard';\nreturn 'unknown';\n})() }}",
              "type": "string"
