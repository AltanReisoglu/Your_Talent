# FinWiki runtime keys
# Copy this file to `.env` and fill real values.

# Required: LLM model provider used by DeepAgents.
GOOGLE_API_KEY=

# User-facing Obsidian vault storage root. The code repo is not opened as the
# user vault; Obsidian should open this folder instead.
FINWIKI_VAULT_ROOT=finwiki-vault

# Optional: override default model.
# Default in code: google_genai:gemini-2.5-flash
FINWIKI_MODEL=google_genai:gemini-2.5-flash

# Optional: Hugging Face Router OpenAI-compatible endpoint.
# Set FINWIKI_MODEL_PROVIDER=huggingface_openai to use these values.
HF_TOKEN=
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3.6-27B:featherless-ai
HF_TIMEOUT=120
HF_MAX_RETRIES=2

# Optional: Vertex AI OpenAI-compatible endpoint.
# Set FINWIKI_MODEL_PROVIDER=vertex_openai to use these values instead of
# google_genai direct Gemini API.
FINWIKI_MODEL_PROVIDER=
VERTEX_AI_ENDPOINT=aiplatform.googleapis.com
VERTEX_AI_REGION=global
VERTEX_AI_PROJECT_ID=
VERTEX_AI_MODEL=google/gemma-4-26b-a4b-it-maas
VERTEX_AI_ENABLE_THINKING=true
# Optional. If omitted, FinWiki calls `gcloud auth print-access-token`.
VERTEX_AI_ACCESS_TOKEN=

# Required for financial-researcher web search.
TAVILY_API_KEY=

# Optional: LangSmith tracing/debugging.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=talentwiki

# Optional: alternative providers / future fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
